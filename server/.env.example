# Server Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nclean?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS (Optional: Comma-separated list for separate frontend deployment, e.g., https://your-frontend.vercel.app)
# Leave empty for all-in-one monolith deployment
CLIENT_URL=
